# URL base de la API consumida por el navegador.
# En desarrollo se deja '/api' y Vite redirige al backend mediante PROXY_TARGET.
VITE_API_URL=/api

# true: usa datos simulados (catálogo/carrito) mientras no existan los endpoints.
# false: llama a la API real (VITE_API_URL + ENDPOINTS en src/servicios/api.js).
VITE_USAR_MOCK=true

# Hacia dónde apunta el proxy de Vite (backend Express).
PROXY_TARGET=http://localhost:3000
